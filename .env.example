# --- Database (Postgres) ---
DATABASE_URL=

# --- Shopify Partner API ---
# Settings > Partner API clients > Manage Partner API clients (organization owner only).
# Needs at least the "Manage apps" permission (add "View financials" too if you want
# revenue data later).
PARTNER_API_ORGANIZATION_ID=
PARTNER_API_ACCESS_TOKEN=
# Confirmed working via introspection; only bump after checking it still resolves.
PARTNER_API_VERSION=2026-07

# --- Auth for this internal dashboard (individual accounts, see app/lib/auth/session.server.ts) ---
SESSION_SECRET=
# Restricts the /register page to this email domain (e.g. "yourcompany.com").
# Leave unset to allow any domain to self-register.
ALLOWED_EMAIL_DOMAIN=

# --- Shop email ingestion (see app/routes/api.ingest-shop.tsx) ---
# Shared secret your individual apps send as the X-Ingest-Secret header when
# reporting a merchant's email at install time. Generate with `openssl rand -hex 32`.
INGEST_SECRET=

# --- Win-back email sending (see app/lib/email/sendWinbackEmail.server.ts) ---
# Leave both empty to fall back to a console-logging provider (no emails actually sent).
RESEND_API_KEY=
EMAIL_FROM="Your App Name <winback@yourdomain.com>"

# --- Misc ---
NODE_ENV=development
LOG_LEVEL=info
